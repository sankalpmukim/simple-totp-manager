{
  "name": "simple-totp-manager",
  "displayName": "Simple totp manager",
  "version": "1.1.0",
  "description": "A simple TOTP authenticator extension.",
  "author": "Sankalp Mukim <sankalpmukim@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv2",
    "dev:chrome": "plasmo dev --target=chrome-mv3",
    "dev:edge": "plasmo dev --target=edge-mv3",
    "build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "build:firefox": "plasmo build --target=firefox-mv2 --zip",
    "build:chrome": "plasmo build --target=chrome-mv3 --zip",
    "build:edge": "plasmo build --target=edge-mv3 --zip",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.9.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "$FIREFOX_EXT_ID",
        "strict_min_version": "109.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    },
    "permissions": [
      "storage",
      "activeTab",
      "scripting"
    ],
    "commands": {
      "autofill-totp": {
        "suggested_key": {
          "default": "Alt+Shift+P"
        },
        "description": "Fill the TOTP code on this page (sets it up the first time)"
      },
      "setup-autofill": {
        "description": "Set up or edit TOTP autofill for this site"
      }
    },
    "optional_host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "optional_permissions": [
      "http://*/*",
      "https://*/*"
    ]
  }
}
